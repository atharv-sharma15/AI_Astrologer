# VedViki Backend Configuration Example

# Application
APP_NAME=VedViki
APP_ENV=development
DEBUG=True
API_PREFIX=/api

# Google Gemini API (Required for live multimodal chart OCR & AI interpretations)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
# Default: Local SQLite (frictionless development)
DATABASE_URL=sqlite+aiosqlite:///./vedviki.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://vedviki_user:password@localhost:5432/vedviki_db

# ChromaDB Vector Database
CHROMA_PERSIST_DIR=./chroma_db
KNOWLEDGE_BASE_DIR=./data/knowledge_base
RAG_ENABLED=True

# File Upload Policies
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=5
DELETE_UPLOAD_AFTER_EXTRACTION=False

# Security & Session Authentication
SECRET_KEY=change-this-to-a-strong-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Calculation Engine (Optional Swiss Ephemeris Integration)
EPHEMERIS_CALCULATION_ENABLED=False
